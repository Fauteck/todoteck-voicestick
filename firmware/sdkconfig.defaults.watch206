# Waveshare ESP32-S3-Touch-AMOLED-2.06 -- Ergaenzung zu sdkconfig.defaults.
#
# Alles andere (8 MB Flash, Octal-PSRAM, OTA-Partitionen, Bluetooth) gilt fuer
# beide Geraete gleich. Die Uhr hat 32 MB Flash; genutzt werden vorerst
# dieselben 8 MB wie beim StickS3, damit Partitionstabelle und OTA-Weg
# identisch bleiben.
CONFIG_VOICE_BOARD_WATCH206=y

# LVGL holt Speicher ueber malloc statt aus seinem festen 64-KB-Topf. Die
# Figur ist hier 150 statt 64 Pixel gross, und was LVGL dafuer an
# Zwischenflaechen braucht, soll in den 8 MB PSRAM landen koennen, statt am
# Topf zu scheitern.
CONFIG_LV_USE_CLIB_MALLOC=y

# Taktfrequenz (Paket H, Punkt 5): Das hier ist nur das Maximum, das esp_pm
# mit der Sperre beim Aufnehmen (Opus) und bei OTA anfaehrt. Im Leerlauf
# laeuft der Chip auf XTAL (40 MHz) oder schlaeft, bei hellem Schirm haelt
# eine APB-Sperre 80 MHz -- siehe init_power_management in main.c.
#
# 160 wie beim StickS3, nicht 240: 0.4.1 setzte 240 und startete auf der Uhr
# nicht mehr (Absturz vor der OTA-Bestaetigung, Rueckfall auf 0.4.0, das mit
# 160 lief). Ein deterministischer Fehler fand sich im Diff nicht; 240 MHz
# beim Start mit hellem AMOLED, PSRAM und Funk am Akku ist aber ein
# Brownout-Kandidat, und Opus braucht die 240 nicht. Seit 0.4.2 wieder 160.
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_160=y
